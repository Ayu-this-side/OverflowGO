# --- API ---
NODE_ENV=development
PORT=4000
APP_CONFIG_PATH=config/app.config.json

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgres://overflowgo:overflowgo_dev@localhost:5432/overflowgo

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_HOURS=12

# --- AI service ---
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=5000

# --- Photo storage (local disk in dev, S3-compatible in prod) ---
PHOTO_STORAGE_DIR=apps/api/uploads
PHOTO_STORAGE_DRIVER=local

# --- Web Push (optional, Phase 4) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Web (Vite, exposed at build time) ---
VITE_API_BASE_URL=/api
